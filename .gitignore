# ---------------------------------------------------------------
# Python environment and caches
# ---------------------------------------------------------------
# Virtual environment: huge, machine-specific, rebuilt from requirements.txt
.venv/
# Compiled bytecode Python creates automatically
__pycache__/
*.py[cod]
# pytest's cache of last-failed tests
.pytest_cache/
# Packaging leftovers if the project is ever pip-installed
*.egg-info/

# ---------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------
# Environment variables (API keys if we swap Ollama for a hosted LLM later)
.env
# Streamlit's secrets file (Phase 9)
.streamlit/secrets.toml

# ---------------------------------------------------------------
# Data: raw documents are never committed; README explains how to download them
# ---------------------------------------------------------------
# Everything inside data/raw/ (markdown + PDFs) ...
data/raw/*
# ... except the placeholder that keeps the empty folder in git
!data/raw/.gitkeep
# Extracted text / chunk store: regenerated by running ingestion
data/processed/*
!data/processed/.gitkeep
# Chroma vector database: large binary files, rebuilt by the indexing step
data/chroma/
# Saved BM25 index (Phase 4), also rebuilt
data/bm25/

# ---------------------------------------------------------------
# Model caches (only if downloads are redirected into the project)
# ---------------------------------------------------------------
# Hugging Face / sentence-transformers cache when HF_HOME points here
.cache/
models/

# ---------------------------------------------------------------
# Evaluation output: commit small CSVs and charts, not big logs
# ---------------------------------------------------------------
# Per-question logs with full chunk text can be several MB per run
eval/results/**/*.jsonl

# ---------------------------------------------------------------
# OS / editor clutter
# ---------------------------------------------------------------
# macOS folder metadata
.DS_Store
